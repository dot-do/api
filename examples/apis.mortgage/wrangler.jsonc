{
  // apis.mortgage — the machine face of register row `mortgage`, serving the
  // apis.mortgage zone since the 2026-08-23 cutover.
  //
  // CUTOVER RECORD (#9 founder ruling, 2026-08-23): the 'no pricing/MCP while
  // the entity is in formation' posture was STRUCK — apis.mortgage is the
  // headless system of record; the licensed operator is the customer. This
  // config REPLACES the pre-cutover waitlist worker in place: same worker
  // name (`apis-mortgage`), same custom-domain route, same WAITLIST KV
  // namespace (5b8bc716e80a40039e1a020de185db7f — no signup or existing data
  // path lost), landing carried over as the browser face with the reframed
  // copy and the machine-face footer row (the api.insure pattern).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "apis-mortgage",
  "main": "src/worker.js",
  "account_id": "b6641681fe423910342b9ffa1364c76d",
  "compatibility_date": "2026-01-24",
  "observability": { "enabled": true },
  "workers_dev": true,

  "routes": [{ "pattern": "apis.mortgage", "custom_domain": true }],

  // favicon.svg + og.png only — the landing itself is embedded
  // (src/landing.js) so the browser face stays content-negotiated at "/".
  "assets": { "directory": "./public" },

  // The durable waitlist register — the SAME namespace the pre-cutover
  // worker wrote to. docs guardrail carried over: submissions are stored
  // durably and none are dropped; a failed write answers a typed 503, never
  // a receipt.
  "kv_namespaces": [
    { "binding": "WAITLIST", "id": "5b8bc716e80a40039e1a020de185db7f" }
  ],

  "vars": {
    "API_NAME": "apis.mortgage"
  }

  // Metering seam transport (§7.4) — bind when the dataset exists; the seam
  // logs structured events regardless.
  // "analytics_engine_datasets": [
  //   { "binding": "METERS", "dataset": "apis_mortgage_meters" }
  // ]
}
