{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-holdings",
  // Build first: npx tsx build.ts  (bundles worker.ts → _worker.js,
  // externalizing the framework's optional oauth.do/rpc.do imports)
  "main": "_worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-01-24",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }

  // The api.holdings CF zone exists (register state: zone-only — held at
  // dynadot, exp 2027-07-31, no record, nothing serving before this example).
  // Route attachment is a deploy decision, not a wave-zero requirement —
  // uncomment at go-live:
  // "routes": [{ "pattern": "api.holdings/*", "zone_name": "api.holdings" }]

  // Optional: set GITHUB_CLIENT_ID (+ secret GITHUB_CLIENT_SECRET) to point
  // /login at a real GitHub OAuth app. Without it the flow runs in labeled
  // demo mode (keys random, unpersisted, not enforced).
  // "vars": { "GITHUB_CLIENT_ID": "" }
}
