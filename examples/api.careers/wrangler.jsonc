{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-careers",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-24",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Zone api.careers is ACTIVE on the .do account (Batch-S sweep,
  // 78c5de9b96675b9ca4b37e52af562a00) — the former founder-visible blocker is
  // cleared. Per the serving ruling, a zone already on .do gets a DIRECT
  // custom domain (the workers.do custom-hostname pattern is for zones living
  // elsewhere). Account id is explicit at deploy time (CLOUDFLARE_ACCOUNT_ID).
  "routes": [
    { "pattern": "api.careers", "custom_domain": true }
  ]
}
