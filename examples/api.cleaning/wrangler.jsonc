{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-cleaning",
  // Build first: npx tsx build.ts  (bundles worker.ts → _worker.js,
  // externalizing the framework's optional oauth.do/rpc.do imports)
  "main": "_worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-01-24",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Zone api.cleaning is ACTIVE on the .do CF account (Batch-S sweep closed
  // the zoneless gap). Zone lives on .do → ruled serving pattern is the
  // DIRECT custom domain (no workers.do hostname hop needed):
  "routes": [{ "pattern": "api.cleaning", "custom_domain": true }]
}
