{
  // apis.dev — wave zero of register row software-it-services
  // Deploy: wrangler deploy (from this directory)
  //
  // DNS cutover DONE (founder-cleared, studio#4, 2026-08-24): apis.dev zone
  // now lives on the .do account (620eaadd23bf6d0fd8741bb1613c1803); Porkbun
  // NS point at ernest/gina. The legacy Vercel 500 zone (Semantics.dev
  // account) is dormant. The custom domain below owns the apex record.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "apis-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-24",

  "workers_dev": true,
  "routes": [{ "pattern": "apis.dev", "custom_domain": true }],

  "vars": {
    "API_NAME": "apis.dev"
  }

  // Metering seam transport (§7.4) — bind when the dataset exists; the seam
  // logs structured events regardless.
  // "analytics_engine_datasets": [
  //   { "binding": "METERS", "dataset": "apis_dev_meters" }
  // ]
}
